#
# Binaries for programs and plugins
**/*.exe
**/*.exe~
**/*.dll
**/*.so
**/*.dylib

# Test binary, built with `go test -c`
**/*.test

# Output of the go coverage tool, specifically when used with LiteIDE
**/*.out

# Go workspace file
backend/go.work
backend/go.work.sum

# env file
**/.env*

# testing
**/coverage

# next.js
**/.next
**/out/

# production
**/build

# misc
**/*.pem

# vercel
**/.vercel

# typescript
**/*.tsbuildinfo
**/next-env.d.ts

